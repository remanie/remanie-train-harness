{
  "version": 2,
  "exit_codes": {
    "gradable": 0,
    "infrastructure": 70
  },
  "outcomes": {
    "completed": {"gradable": true, "causes": []},
    "max_turns": {"gradable": true, "causes": []},
    "cancelled": {"gradable": true, "causes": ["deadline", "signal"]},
    "error": {"gradable": true, "causes": ["grok"]},
    "endpoint_unavailable": {"gradable": false, "causes": ["unreachable", "refused"]},
    "infrastructure": {"gradable": false, "causes": ["config", "grok_binary", "grok_startup", "proxy_bind", "internal"]}
  },
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["base_url", "model", "user_query", "workspace", "session_dir", "sampling_params", "max_turns", "deadline_secs", "context_window_tokens"],
    "properties": {
      "base_url": {"type": "string", "pattern": "^https?://[^/?#@\\s]+(/[^?#\\s]*)?/v1/?$"},
      "api_key_env": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "model": {"type": "string", "pattern": "\\S"},
      "user_query": {"type": "string", "pattern": "\\S"},
      "workspace": {"type": "string", "pattern": "^/"},
      "session_dir": {"type": "string", "pattern": "^/"},
      "sampling_params": {
        "type": "object",
        "required": ["max_tokens"],
        "properties": {
          "max_tokens": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "temperature": {"type": "number", "minimum": 0}
        },
        "propertyNames": {"not": {"enum": ["model", "messages", "tools", "tool_choice", "stream", "stream_options", "max_completion_tokens"]}}
      },
      "max_turns": {"type": "integer", "minimum": 1, "maximum": 512},
      "deadline_secs": {"type": "integer", "minimum": 1, "maximum": 86400},
      "context_window_tokens": {"type": "integer", "minimum": 1},
      "compaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "threshold_percent": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["contract", "outcome", "gradable", "final_answer", "turns", "compactions", "model_calls", "usage", "wall_time_ms", "grok_exit", "grok_session_dir"],
    "properties": {
      "contract": {"const": 2},
      "outcome": {"enum": ["completed", "max_turns", "cancelled", "error", "endpoint_unavailable", "infrastructure"]},
      "cause": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}}},
      "gradable": {"type": "boolean"},
      "final_answer": {"type": "string"},
      "turns": {"type": "integer", "minimum": 0},
      "compactions": {"type": "integer", "minimum": 0},
      "model_calls": {"type": "integer", "minimum": 0},
      "usage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt_tokens", "completion_tokens", "cached_tokens", "complete"],
        "properties": {
          "prompt_tokens": {"type": "integer", "minimum": 0},
          "completion_tokens": {"type": "integer", "minimum": 0},
          "cached_tokens": {"type": "integer", "minimum": 0},
          "complete": {"type": "boolean"}
        }
      },
      "wall_time_ms": {"type": "integer", "minimum": 0},
      "grok_exit": {
        "oneOf": [
          {"type": "null"},
          {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "integer"}}},
          {"type": "object", "additionalProperties": false, "required": ["signal"], "properties": {"signal": {"type": "integer"}}}
        ]
      },
      "grok_session_dir": {"type": ["string", "null"]}
    },
    "allOf": [
      {
        "if": {"properties": {"outcome": {"enum": ["endpoint_unavailable", "infrastructure"]}}},
        "then": {"properties": {"gradable": {"const": false}}},
        "else": {"properties": {"gradable": {"const": true}}}
      },
      {
        "if": {"properties": {"outcome": {"enum": ["completed", "max_turns"]}}},
        "then": {"not": {"required": ["cause"]}},
        "else": {"required": ["cause"]}
      }
    ]
  }
}
